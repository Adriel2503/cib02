<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.soundboxd.controller.CatalogoController" styleClass="fondo">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="barra-superior">
            <Label text="Soundboxd" styleClass="titulo-barra"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnMisListas" text="Mis listas" onAction="#onMisListas" styleClass="boton-secundario"/>
            <Button fx:id="btnPerfil" text="Perfil" onAction="#onPerfil" styleClass="boton-secundario"/>
            <Button fx:id="btnModeracion" text="Moderación" onAction="#onModeracion" styleClass="boton-secundario"/>
            <Label fx:id="lblUsuario"/>
            <Button fx:id="btnSesion" onAction="#onSesion" styleClass="boton-secundario"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="16" right="20" bottom="8" left="20"/>
            </padding>
            <HBox spacing="8">
                <TextField fx:id="txtBuscar" promptText="Buscar por álbum, artista o género"
                           HBox.hgrow="ALWAYS" onAction="#onBuscar"/>
                <Button text="Buscar" onAction="#onBuscar" styleClass="boton-primario"/>
                <Button text="Ver detalle" onAction="#onDetalle" styleClass="boton-secundario"/>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTitulo" text="Álbum" prefWidth="280"/>
                    <TableColumn fx:id="colArtista" text="Artista" prefWidth="220"/>
                    <TableColumn fx:id="colAnio" text="Año" prefWidth="70"/>
                    <TableColumn fx:id="colGenero" text="Género" prefWidth="140"/>
                    <TableColumn fx:id="colPromedio" text="Promedio" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <Label fx:id="lblMensaje" styleClass="nota">
            <padding>
                <Insets top="6" right="20" bottom="10" left="20"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
